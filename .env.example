# Copy to .env and edit. Every value is optional; defaults work for local development.

# ---------------------------------------------------------------- site
SITE_NAME=The Signal
# Public URL of the site. Used for links inside emails (confirm / unsubscribe / play).
BASE_URL=http://localhost:8000
TIMEZONE=Asia/Kolkata
# When the daily newsletter goes out (24h clock, in TIMEZONE).
SEND_TIME=07:30
# The website edition is rebuilt every N hours.
REFRESH_HOURS=3
# Protects /api/admin/*. Leave empty to disable the admin API entirely.
ADMIN_TOKEN=

# ---------------------------------------------------------------- email
# Leave SMTP_HOST empty and every email is written as an .eml file to backend/data/outbox/
# (perfect for development: open the file to see exactly what a subscriber would get).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Gmail: create an "App password" (Google Account > Security > 2-Step Verification).
SMTP_PASSWORD=
# starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
MAIL_FROM=
MAIL_FROM_NAME=The Signal
# true  = new subscribers must click a confirmation link (recommended, avoids abuse)
# false = subscribed immediately
DOUBLE_OPT_IN=true
# Send today's briefing straight away when someone confirms.
SEND_WELCOME_DIGEST=true

# ---------------------------------------------------------------- optional LLM editor
# With a key, a model rewrites headlines, writes the one-line "why it matters", rates impact
# and picks the lead story. Without one, the paper still works using extractive summaries.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------------------------------------------------------------- advanced (all optional)
# false = do not run the in-process scheduler (use cron + `python -m app.cli send` instead)
SCHEDULER_ENABLED=true
# If the server was down at SEND_TIME, still send when it comes back within this many hours.
SEND_GRACE_HOURS=6
# Approximate size of the email in words (1050 words is about 4.7 minutes at 225 wpm).
DIGEST_WORD_BUDGET=1050
# Only set true behind YOUR OWN reverse proxy that sets X-Forwarded-For (otherwise clients could spoof it).
TRUST_PROXY=false
# Where the SQLite file and dev outbox live (defaults are inside backend/data/).
DB_PATH=
OUTBOX_DIR=
# Pause between emails in a batch, to be gentle on your SMTP provider's rate limits.
SEND_DELAY_SECONDS=0.2
