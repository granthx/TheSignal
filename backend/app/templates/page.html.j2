<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ title }} · {{ site_name }}</title>
<style>
  :root { --paper:#f6f3ea; --ink:#0b0b0c; --red:#c8141b; }
  * { box-sizing: border-box; }
  body { margin:0; min-height:100vh; display:grid; place-items:center; padding:20px; background:var(--paper);
         background-image: radial-gradient(rgba(0,0,0,.18) 1px, transparent 1.4px); background-size: 7px 7px;
         font-family: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif; color:var(--ink); }
  main { width:min(520px,100%); background:#fffdf7; border:4px solid var(--ink); box-shadow:10px 10px 0 var(--ink); padding:30px 28px; }
  .brand { font-family: Bangers, Impact, 'Arial Black', sans-serif; font-size:30px; letter-spacing:2px; margin:0 0 18px; }
  h1 { font-family: Bangers, Impact, 'Arial Black', sans-serif; font-size:40px; letter-spacing:1.5px; line-height:1.05; margin:0 0 12px; color:{{ 'var(--ink)' if ok else 'var(--red)' }}; }
  p { font-size:16px; line-height:1.55; margin:0 0 22px; }
  a.btn, button { display:inline-block; font: inherit; font-family: Bangers, Impact, sans-serif; font-size:20px; letter-spacing:1px; cursor:pointer;
                  background:var(--red); color:#fff; border:3px solid var(--ink); padding:10px 20px; text-decoration:none; box-shadow:4px 4px 0 var(--ink); }
  a.btn.ghost { background:#fffdf7; color:var(--ink); }
  a.btn:focus-visible, button:focus-visible { outline:3px solid var(--ink); outline-offset:3px; }
  .row { display:flex; gap:12px; flex-wrap:wrap; }
</style>
</head>
<body>
<main>
  <div class="brand">{{ site_name|upper }}</div>
  <h1>{{ heading }}</h1>
  <p>{{ message }}</p>
  <div class="row">
{% if action %}
    <form method="post" action="{{ action.url }}"><button type="submit">{{ action.label }}</button></form>
{% endif %}
    <a class="btn{{ ' ghost' if action else '' }}" href="{{ base_url }}/">Back to the paper</a>
  </div>
</main>
</body>
</html>
