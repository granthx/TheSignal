<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light only"><title>Confirm your subscription</title></head>
<body style="margin:0;padding:0;background:#e9e5da;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#e9e5da;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="520" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:520px;background:#fbf9f3;border:3px solid #0b0b0c;">
  <tr><td style="background:#0b0b0c;padding:16px 24px;font-family:Impact,'Arial Black',sans-serif;font-size:36px;letter-spacing:2px;color:#fbf9f3;">{{ site_name|upper }}</td></tr>
  <tr><td style="height:6px;background:#c8141b;font-size:0;line-height:0;">&nbsp;</td></tr>
  <tr><td style="padding:28px 24px 8px 24px;font-family:Georgia,'Times New Roman',serif;font-size:22px;font-weight:bold;color:#0b0b0c;">One click and you're in.</td></tr>
  <tr><td style="padding:4px 24px 20px 24px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.55;color:#333;">
    Confirm your email and {{ site_name }} will send you one short briefing every day at {{ send_time }} ({{ timezone }}): only the AI, chips and space news that matters, readable in about five minutes.
  </td></tr>
  <tr><td align="center" style="padding:0 24px 28px 24px;">
    <a href="{{ confirm_url }}" style="display:inline-block;background:#c8141b;color:#ffffff;font-family:Impact,'Arial Black',sans-serif;font-size:18px;letter-spacing:1px;text-decoration:none;padding:12px 24px;border:3px solid #0b0b0c;">CONFIRM SUBSCRIPTION</a>
  </td></tr>
  <tr><td style="padding:16px 24px 22px 24px;border-top:3px solid #0b0b0c;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.6;color:#666;">
    If the button does not work, paste this link into your browser:<br><span style="word-break:break-all;">{{ confirm_url }}</span><br><br>
    Didn't ask for this? Ignore this email and nothing will happen.
  </td></tr>
</table>
</td></tr>
</table>
</body>
</html>
